# ── Supabase (required) ─────────────────────────────────────────────────
# Create a free project at https://supabase.com → Project Settings → API
SUPABASE_URL=                # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=           # "publishable" key (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=   # "secret" key (sb_secret_…) — BACKEND ONLY, NEVER COMMIT

# Same Supabase values, exposed to the Vite frontend build
VITE_SUPABASE_URL=           # same as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=      # same as SUPABASE_ANON_KEY (publishable)

# Backend URL the frontend talks to
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK_SSE=false      # true = frontend uses mock SSE + mock graph module

# Optional override for where per-user KuzuDB graphs live on the backend filesystem.
# In docker-compose this is set to /data/graphs. Leave blank to use ~/.qlankr/graphs.
QLANKR_GRAPHS_ROOT=

# ── Optional: LangSmith tracing ─────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=qlankr

# ── Legacy fallbacks ────────────────────────────────────────────────────
# After Phase 3 these will be per-user via the Settings UI in the app.
# Until per-user wiring is complete, the agent runtime still reads from env.
ANTHROPIC_API_KEY=           # Claude API key
GITHUB_TOKEN=                # GitHub PAT — public_repo scope minimum, repo scope for private repos

# Optional legacy env-var integration credentials (now stored per-user in the app).
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
NOTION_API_KEY=
NOTION_WORKSPACE_ID=
CONFLUENCE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE_KEY=
GRAFANA_URL=
GRAFANA_API_KEY=
KIBANA_URL=
KIBANA_TOKEN=
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
